# Hardware Agent configuration.
# Copy this file to ".env" and fill in whichever keys you have.
# The app runs without any of them, but distributor data is only real-time
# once at least one live provider below is configured.

# ---------------------------------------------------------------- server ---
# HOST controls who can reach the app.
#   127.0.0.1  this machine only. Nobody else can connect, whatever URL they use.
#   0.0.0.0    every network interface, so others on your network can reach it
#              at http://<your-LAN-IP>:8080/ -- the banner prints that address
#              on startup. There is no login: anyone who can reach the port can
#              search, price BOMs and spend your distributor API quota.
HOST=127.0.0.1
PORT=8080
# Shared password. Leave empty for no sign-in, which is right when the app is
# only reachable from this machine. Set one BEFORE putting it on a network or
# the internet: there are no user accounts, so this single password is what
# stands between a public URL and your distributor API quota.
APP_PASSWORD=

REQUEST_TIMEOUT=12          # seconds allowed per distributor before it is marked timed out
MAX_RESULTS_PER_PROVIDER=12
CACHE_TTL=60                # only affects /api/search without fresh=1; 0 disables
DISPLAY_CURRENCY=USD

# ------------------------------------------------------ live data sources ---
# Nexar / Octopart  -- https://portal.nexar.com  (free tier)
# Highest value key: one call returns offers from Digi-Key, Mouser,
# Arrow, TME and others, so configure this first if you configure only one.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Mouser Search API -- https://www.mouser.com/api-hub/  (free, ~1000 calls/day)
MOUSER_API_KEY=

# Digi-Key Product Information v4 -- https://developer.digikey.com  (free)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SITE=US
DIGIKEY_CURRENCY=USD

# Farnell / element14 / Newark -- https://partner.element14.com  (free)
# Pick the storefront for your region, e.g. in.element14.com, www.newark.com,
# uk.farnell.com, de.farnell.com, sg.element14.com, au.element14.com
FARNELL_API_KEY=
FARNELL_STORE=uk.farnell.com

# -------------------------------------------------------------- optional ---
# Built-in offline reference catalogue of 187 parts. Default "auto" means it
# stands down automatically whenever a live source can answer, so generated
# figures never sit in the same table as real ones. Force it with "true"
# (useful offline), or switch it off entirely with "false".
ENABLE_DEMO=auto

# Approximate FX rates used to show one common currency, as "1 X = N USD".
# Override with live rates from your own source if pricing accuracy matters.
# Exchange rates are fetched live from a keyless daily feed so cross-currency
# comparison is accurate. Set to false to pin conversions to FX_RATES below.
ENABLE_LIVE_FX=true

# FX_RATES={"INR":0.012,"EUR":1.09,"GBP":1.27}

# ------------------------------------------------ photo identification ---
# Upload a photo of a component and a vision model running locally under
# Ollama reads the package markings and names the part, which is then priced
# across every configured supplier. The image is sent to Ollama on this
# machine only -- it never leaves it.
#
# Needs a multimodal model. Any of these work; the first is the best at
# reading small printed markings and still fits a 4 GB card:
#     ollama pull qwen2.5vl:3b
#     ollama pull moondream        (smallest, ~1.7 GB, weaker at text)
#     ollama pull llava:7b
ENABLE_VISION=true
OLLAMA_HOST=http://127.0.0.1:11434
# Leave blank to auto-pick the best installed vision model.
OLLAMA_VISION_MODEL=
# Seconds. A cold model load plus inference on a small GPU is slow -- raise
# this if identification times out.
OLLAMA_TIMEOUT=180
# How long Ollama keeps the model in memory between photos.
OLLAMA_KEEP_ALIVE=10m

# Accuracy controls for photo identification. A small vision model will invent
# a plausible part number if you let it, so two guards sit around it:
#   VISION_OCR_PASS  reads the package in its own turn, with identification
#                    explicitly forbidden, before anything is identified. Costs
#                    a second round of inference.
#   VISION_VERIFY    looks each proposed part number up at the live
#                    distributors and demotes anything nobody stocks. Where the
#                    string printed on the package checks out and the model's
#                    reading does not, the printed string wins.
VISION_OCR_PASS=true
VISION_VERIFY=true

# ------------------------------------------- bill of materials pricing ---
# Upload a BOM as .xlsx, .csv or .pdf and every line is priced across every
# configured supplier, then exported back to Excel or PDF.
#
#   BOM_MODEL_ASSIST  let the local Ollama model work out which columns hold
#                     the part number and the quantity when the headings alone
#                     are not enough. Its answer is checked against the data.
#   BOM_CONCURRENCY   part numbers priced at once. Each one fans out to every
#                     supplier, so raising this runs into distributor rate
#                     limits rather than going faster.
#   BOM_MAX_LINES     cap on how many lines one upload will price.
#   BOM_RESULTS_PER_PROVIDER
#                     rows to ask each distributor for per BOM line. Not how
#                     many are shown -- one offer per supplier is kept -- but
#                     how far down that distributor's own keyword ranking the
#                     exact part may sit and still be found. Too low and a
#                     near-miss the distributor ranks higher gets priced
#                     instead. It is one request either way.
#
# Rate limiting. Distributors police a per-second query rate, and on a long BOM
# they will start refusing calls ("Account Over Queries Per Second Limit"). A
# refused supplier does not fail loudly -- it just stops appearing in the
# comparison for that line, so the cheapest offer can disappear with it. Calls
# to any one supplier are therefore spaced out, and a refusal is retried.
#   PROVIDER_MIN_INTERVAL_MS  smallest gap between two calls to the SAME supplier.
#   PROVIDER_RETRIES          extra attempts when a call fails in a way waiting fixes.
#   PROVIDER_RETRY_BACKOFF_MS wait before the first retry; grows with each attempt.
BOM_MODEL_ASSIST=true
BOM_CONCURRENCY=3
BOM_MAX_LINES=250
BOM_RESULTS_PER_PROVIDER=25
# Daily API allowances, for the suppliers that publish a limit on their
# dashboard but never in a response header. Digi-Key reports its own and needs
# nothing here. Leave at 0 to just count calls without a limit.
#   Mouser:  mouser.com/api-hub/    Farnell: partner.element14.com
MOUSER_DAILY_LIMIT=0
FARNELL_DAILY_LIMIT=0

PROVIDER_MIN_INTERVAL_MS=500
PROVIDER_RETRIES=4
PROVIDER_RETRY_BACKOFF_MS=800
